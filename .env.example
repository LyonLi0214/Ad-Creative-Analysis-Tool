# ==================== Ad Creative Analysis Tool ====================
# Copy this file to .env and fill in your actual credentials.
#   cp .env.example .env
#
# All fields with "your_..." need real values.

# ── NocoDB (optional: used for legacy sync) ──
NOCODB_BASE=http://localhost:8080
NOCODB_TOKEN=your_nocodb_api_token
NOCODB_BASE_ID=your_nocodb_base_id
NOCODB_TABLE_ASSETS=table_id_1
NOCODB_TABLE_ANALYSIS=table_id_2
NOCODB_TABLE_TIMELINE=table_id_3
NOCODB_TABLE_DICT=table_id_4
NOCODB_TABLE_AGGREGATION=table_id_5

# ── AI Analysis API (OpenAI-compatible) ──
OPENAI_BASE=https://api.openai.com/v1
OPENAI_KEY=your_api_key
OPENAI_MODEL=gpt-4o

# ── Alibaba Cloud OSS (video source storage) ──
OSS_AK_ID=your_oss_access_key_id
OSS_AK_SECRET=your_oss_access_key_secret
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_BUCKET=your-bucket-name

# ── Feishu / Lark Bot ──
LARK_APP_ID=cli_your_app_id
LARK_APP_SECRET=your_app_secret

# ── Feishu Base (for sync scripts) ──
FEISHU_BASE_TOKEN=your_feishu_base_token

# ── Claude CLI (optional: used by local bot recognition) ──
# On Mac: typically "claude" (from brew) or full path
CLAUDE_CLI_PATH=claude

# ── Lark CLI (optional: used by feishu bot) ──
# On Mac: typically "lark-cli" from npm
LARK_CLI_PATH=lark-cli

# ── Meta / Facebook Marketing API (optional: FB ad dashboard) ──
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_IDS=
META_GRAPH_API_VERSION=

# ── Google Ads API (optional) ──
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_IDS=

# ── Cross-platform dashboard defaults ──
ADS_REPORT_TIMEZONE=Asia/Shanghai
ADS_REPORT_CURRENCY=USD
